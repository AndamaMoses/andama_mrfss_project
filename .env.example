# Onzima Dawa environment settings
#
# config.py loads this file automatically at startup (real environment
# variables always win). Keep secrets here and never commit the file.
#
# PowerShell alternative if you prefer shell exports:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]+)=(.*)$') {
#       [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
#     }
#   }
#   python run.py

# Required in production (ProdConfig refuses to start without it).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value

# SQLite database and upload directory.
# DRUGSHOP_DB=C:\path\to\instance\drugshop.db
# DRUGSHOP_UPLOADS=C:\path\to\instance\uploads

# Bundle seeded on first boot: core | pro | growth | tender | legacy.
# New installations should start on core. Onzima is grandfathered on legacy.
DRUGSHOP_BUNDLE=core

# First-boot passwords. Leave unset locally to use the documented development
# defaults (admin123 / grace123); always set strong values on a hosted install.
# Existing accounts are never changed by these variables.
ADMIN_PASSWORD=
STAFF_PASSWORD=

# Seed synthetic demo products, sales, and patients on first boot. Never enable
# this against a database that contains real shop data.
DEMO_SEED=0

# Support number shown on upgrade prompts, e.g. +256776102744.
SUPPORT_WHATSAPP=

# Set only when Tender Copilot is served from a subdomain of the pharmacy host.
# SESSION_COOKIE_DOMAIN=.example.com

# Local auto-reload only. Never set this in production.
FLASK_DEBUG=0

# --- MTN MoMo Collections (https://momodeveloper.mtn.com) -------------------
# Subscribe to the Collections product in the developer portal, then copy the
# primary key here. .env is loaded automatically at startup (real environment
# variables win). Leave the key blank to keep MoMo disabled: the POS still
# records manual "MTN MoMo" takings.
MOMO_SUBSCRIPTION_KEY=
# sandbox for testing, or a country environment such as mtnuganda in production.
MOMO_TARGET_ENVIRONMENT=sandbox
# Created once with: flask --app run momo provision --save
MOMO_API_USER=
MOMO_API_KEY=
# Optional overrides; blank uses https://sandbox.momodeveloper.mtn.com for
# sandbox and https://proxy.momoapi.mtn.com for production.
MOMO_BASE_URL=
# Blank uses EUR on the sandbox (the only currency MTN accepts there) and UGX
# on production environments. Set it explicitly for other markets.
MOMO_CURRENCY=
# Public HTTPS endpoint that receives MTN's payment callback (optional).
# Include the secret as a query string, e.g.
#   MOMO_CALLBACK_URL=https://shop.example/api/momo/callback?token=long-random-value
# Blank disables callbacks; status polling still works.
MOMO_CALLBACK_URL=
# Shared secret required by /api/momo/callback. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Blank disables the callback route.
MOMO_CALLBACK_SECRET=
# HTTP timeout for MTN calls, in seconds. Blank or invalid uses 20.
MOMO_TIMEOUT=20
# Re-check a MoMo reference when the sale is recorded (default on). Set to 0
# only for a monitored rollout where the counter is the source of truth.
MOMO_VERIFY_SALES=1

# --- Airtel Money OpenAPI (https://developers.airtel.africa) ----------------
# Create an Airtel developer app with the Collection API enabled, then copy its
# client id/secret here. Leave them blank to keep Airtel disabled: the POS still
# records manual "Airtel Money" takings.
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CURRENCY=UGX
AIRTEL_COUNTRY=UG
# HTTP timeout for Airtel calls, in seconds. Blank or invalid uses 20.
AIRTEL_TIMEOUT=20
# Re-check an Airtel reference when the sale is recorded (default on). Set to 0
# only for a monitored rollout where the counter is the source of truth.
AIRTEL_VERIFY_SALES=1
# Public HTTPS endpoint registered with Airtel for payment callbacks (optional).
# Include the secret as a query string, e.g.
#   AIRTEL_CALLBACK_URL=https://shop.example/api/payments/airtel/callback?token=long-random-value
# The callback never trusts the body; it re-queries the status endpoint before
# updating the ledger. Blank disables callbacks; polling and `momo reconcile`
# still work.
AIRTEL_CALLBACK_URL=
# Shared secret required by /api/payments/airtel/callback. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Blank disables the callback route.
AIRTEL_CALLBACK_SECRET=
